{
  "name": "luany-lte",
  "displayName": "Luany Template Engine - LTE",
  "description": "Syntax highlighting, snippets and Emmet support for Luany Template Engine (.lte) files",
  "version": "1.1.0",
  "publisher": "luany",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/luany-ecosystem/luany-lte-vscode"
  },
  "bugs": {
    "url": "https://github.com/luany-ecosystem/luany-lte-vscode/issues"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "luany",
    "lte",
    "template engine",
    "php",
    "blade",
    "templating",
    "html",
    "syntax highlighting",
    "ast",
    "compiler",
    "blade-like",
    "php template",
    "blade syntax",
    "php views",
    "template syntax highlighting",
    "mvc",
    "php snippets"
  ],
  "icon": "icons/luany-icon.png",
  "contributes": {
    "languages": [
      {
        "id": "lte",
        "aliases": [
          "Luany LTE",
          "LTE"
        ],
        "extensions": [
          ".lte"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lte",
        "scopeName": "text.lte",
        "path": "./syntaxes/lte.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.php.lte": "php",
          "meta.embedded.block.css.lte": "css",
          "meta.embedded.block.js.lte": "javascript",
          "meta.embedded.echo.lte": "php",
          "meta.embedded.raw.lte": "php"
        }
      }
    ],
    "snippets": [
      {
        "language": "lte",
        "path": "./snippets/lte.json"
      }
    ],
    "configurationDefaults": {
      "[lte]": {
        "editor.autoIndent": "full",
        "editor.quickSuggestions": {
          "other": true,
          "comments": false,
          "strings": true
        }
      },
      "emmet.includeLanguages": {
        "lte": "html"
      }
    }
  },
  "scripts": {
    "fetch-grammars": "sh scripts/fetch-grammars.sh",
    "test": "vscode-tmgrammar-test -g test/grammars/html.tmLanguage.json -g test/grammars/php.tmLanguage.json -g test/grammars/php-html.tmLanguage.json -g test/grammars/css.tmLanguage.json -g test/grammars/JavaScript.tmLanguage.json -g syntaxes/lte.tmLanguage.json \"test/cases/*.test.lte\"",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "vscode-tmgrammar-test": "^0.1.3",
    "@vscode/vsce": "^3.2.1"
  }
}

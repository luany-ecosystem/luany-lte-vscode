{
  "name": "luany-lte",
  "displayName": "Luany Template Engine - LTE",
  "description": "Syntax highlighting, snippets and Emmet support for Luany Template Engine (.lte) files",
  "version": "1.2.0",
  "publisher": "luany",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/luany-ecosystem/luany-lte-vscode"
  },
  "bugs": {
    "url": "https://github.com/luany-ecosystem/luany-lte-vscode/issues"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "luany",
    "lte",
    "template engine",
    "php",
    "blade",
    "templating",
    "html",
    "syntax highlighting",
    "blade-like",
    "php template",
    "blade syntax",
    "php views",
    "template syntax highlighting",
    "mvc",
    "php snippets",
    "luany framework"
  ],
  "icon": "icons/luany-icon.png",
  "contributes": {
    "languages": [
      {
        "id": "lte",
        "aliases": [
          "Luany LTE",
          "LTE"
        ],
        "extensions": [
          ".lte"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/lte-file.png",
          "dark": "./icons/lte-file.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "lte",
        "scopeName": "text.lte",
        "path": "./syntaxes/lte.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.php.lte": "php",
          "meta.embedded.block.css.lte": "css",
          "meta.embedded.block.js.lte": "javascript",
          "meta.embedded.echo.lte": "php",
          "meta.embedded.raw.lte": "php"
        }
      }
    ],
    "snippets": [
      {
        "language": "lte",
        "path": "./snippets/lte.json"
      }
    ],
    "configurationDefaults": {
      "[lte]": {
        "editor.autoIndent": "full",
        "editor.quickSuggestions": {
          "other": true,
          "comments": false,
          "strings": true
        }
      },
      "emmet.includeLanguages": {
        "lte": "html"
      }
    },
    "commands": [
      {
        "command": "luanyLte.validateViews",
        "title": "Validate views",
        "category": "Luany LTE"
      }
    ],
    "configuration": {
      "title": "Luany LTE",
      "properties": {
        "luanyLte.validate.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show LTE structure and PHP syntax errors (runs `luany view:check` on open and save). Requires luany/cli >= 1.4."
        },
        "luanyLte.validate.bootApp": {
          "type": "boolean",
          "default": false,
          "description": "Boot the application while validating, so directives registered by service providers are known. Slower."
        },
        "luanyLte.cliPath": {
          "type": "string",
          "default": "",
          "description": "Path to the luany executable. Empty: vendor/bin/luany in the project, then `luany` on PATH."
        }
      }
    }
  },
  "scripts": {
    "fetch-grammars": "sh scripts/fetch-grammars.sh",
    "test": "node --test test/unit/annotations.test.js && vscode-tmgrammar-test -g test/grammars/html.tmLanguage.json -g test/grammars/php.tmLanguage.json -g test/grammars/php-html.tmLanguage.json -g test/grammars/css.tmLanguage.json -g test/grammars/JavaScript.tmLanguage.json -g syntaxes/lte.tmLanguage.json \"test/cases/*.test.lte\"",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "vscode-tmgrammar-test": "^0.1.3",
    "@vscode/vsce": "^3.2.1"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:lte",
    "workspaceContains:**/*.lte"
  ]
}

{
  "Component": {
    "prefix": "component",
    "body": [
      "@style",
      "    .${1:component-name} {",
      "        $2",
      "    }",
      "@endstyle",
      "",
      "<div class=\"${1:component-name}\">",
      "    $0",
      "</div>",
      "",
      "@script(defer)",
      "    document.querySelectorAll('.${1:component-name}').forEach(function(el) {",
      "        $3",
      "    });",
      "@endscript"
    ],
    "description": "Self-contained LTE component with collocated CSS and JS"
  },
  "If": {
    "prefix": "if",
    "body": [
      "@if(${1:condition})",
      "    $0",
      "@endif"
    ],
    "description": "@if / @endif block"
  },
  "If Else": {
    "prefix": "ifelse",
    "body": [
      "@if(${1:condition})",
      "    $2",
      "@else",
      "    $0",
      "@endif"
    ],
    "description": "@if / @else / @endif block"
  },
  "Foreach": {
    "prefix": "foreach",
    "body": [
      "@foreach(${1:\\$items} as ${2:\\$item})",
      "    $0",
      "@endforeach"
    ],
    "description": "@foreach / @endforeach loop"
  },
  "Forelse": {
    "prefix": "forelse",
    "body": [
      "@forelse(${1:\\$items} as ${2:\\$item})",
      "    $3",
      "@empty",
      "    <p>${0:No items found.}</p>",
      "@endforelse"
    ],
    "description": "@forelse / @empty / @endforelse loop with empty state"
  },
  "Section": {
    "prefix": "section",
    "body": [
      "@section('${1:name}')",
      "    $0",
      "@endsection"
    ],
    "description": "@section / @endsection block"
  },
  "Style Block": {
    "prefix": "style",
    "body": [
      "@style",
      "    ${0}",
      "@endstyle"
    ],
    "description": "Inline CSS block — accumulated by AssetStack"
  },
  "Script Block": {
    "prefix": "script",
    "body": [
      "@script(defer)",
      "    ${0}",
      "@endscript"
    ],
    "description": "Inline JS block with defer — accumulated by AssetStack"
  },
  "Push": {
    "prefix": "push",
    "body": [
      "@push('${1:head}')",
      "    $0",
      "@endpush"
    ],
    "description": "@push / @endpush — push content into named stack"
  },
  "Include": {
    "prefix": "include",
    "body": [
      "@include('${1:components.name}')"
    ],
    "description": "@include partial view"
  },
  "Include with data": {
    "prefix": "include-data",
    "body": [
      "@include('${1:components.name}', ['${2:key}' => ${3:\\$value}])"
    ],
    "description": "@include partial view with data"
  },
  "CSRF": {
    "prefix": "csrf",
    "body": [
      "@csrf"
    ],
    "description": "CSRF hidden input field"
  },
  "Auth": {
    "prefix": "auth",
    "body": [
      "@auth",
      "    $0",
      "@endauth"
    ],
    "description": "@auth / @endauth guard block"
  },
  "Guest": {
    "prefix": "guest",
    "body": [
      "@guest",
      "    $0",
      "@endguest"
    ],
    "description": "@guest / @endguest guard block"
  },
  "Component with slot": {
    "prefix": [
      "component-use",
      "@component"
    ],
    "body": [
      "@component('${1:components.alert}', [${2:'type' => 'info'}])",
      "\t@slot('${3:title}')",
      "\t\t$4",
      "\t@endslot",
      "\t$0",
      "@endcomponent"
    ],
    "description": "LTE component with a named slot"
  },
  "Slot": {
    "prefix": [
      "@slot",
      "slot"
    ],
    "body": [
      "@slot('${1:name}')",
      "\t$0",
      "@endslot"
    ],
    "description": "Named slot inside a component"
  },
  "JSON": {
    "prefix": [
      "@json",
      "json"
    ],
    "body": [
      "@json(${1:\\$data})"
    ],
    "description": "Safe JSON output for inline JavaScript"
  },
  "Class": {
    "prefix": [
      "@class",
      "class"
    ],
    "body": [
      "@class(['${1:btn}', '${2:active}' => ${3:\\$isActive}])"
    ],
    "description": "Conditional CSS classes"
  },
  "Method": {
    "prefix": [
      "@method",
      "method"
    ],
    "body": [
      "@method('${1|PUT,PATCH,DELETE|}')"
    ],
    "description": "HTTP method spoofing field"
  },
  "Escaped echo literal": {
    "prefix": [
      "@{{"
    ],
    "body": [
      "@{{ ${1:value} }}"
    ],
    "description": "Output literal {{ }} (not compiled)"
  },
  "Unless": {
    "prefix": [
      "unless",
      "@unless"
    ],
    "body": [
      "@unless(${1:\\$condition})",
      "\t$0",
      "@endunless"
    ],
    "description": "@unless / @endunless block"
  },
  "Isset": {
    "prefix": [
      "isset",
      "@isset"
    ],
    "body": [
      "@isset(${1:\\$var})",
      "\t$0",
      "@endisset"
    ],
    "description": "@isset / @endisset block"
  },
  "If empty": {
    "prefix": [
      "ifempty",
      "@ifempty"
    ],
    "body": [
      "@ifempty(${1:\\$var})",
      "\t$0",
      "@endifempty"
    ],
    "description": "@ifempty / @endifempty block"
  },
  "For": {
    "prefix": [
      "for",
      "@for"
    ],
    "body": [
      "@for(\\$${1:i} = 0; \\$${1:i} < ${2:10}; \\$${1:i}++)",
      "\t$0",
      "@endfor"
    ],
    "description": "@for / @endfor loop"
  },
  "While": {
    "prefix": [
      "while",
      "@while"
    ],
    "body": [
      "@while(${1:\\$condition})",
      "\t$0",
      "@endwhile"
    ],
    "description": "@while / @endwhile loop"
  },
  "PHP block": {
    "prefix": [
      "php",
      "@php"
    ],
    "body": [
      "@php",
      "\t$0",
      "@endphp"
    ],
    "description": "@php / @endphp block"
  },
  "Form": {
    "prefix": [
      "form"
    ],
    "body": [
      "<form method=\"POST\" action=\"${1:/}\">",
      "\t@csrf",
      "\t$0",
      "\t<button type=\"submit\">${2:Save}</button>",
      "</form>"
    ],
    "description": "POST form with @csrf"
  },
  "Form with method": {
    "prefix": [
      "form-method"
    ],
    "body": [
      "<form method=\"POST\" action=\"${1:/}\">",
      "\t@csrf",
      "\t@method('${2|PUT,PATCH,DELETE|}')",
      "\t$0",
      "\t<button type=\"submit\">${3:Save}</button>",
      "</form>"
    ],
    "description": "Form with @csrf and @method spoofing"
  },
  "Dump": {
    "prefix": [
      "dump",
      "@dump"
    ],
    "body": [
      "@dump(${1:\\$var})"
    ],
    "description": "@dump($var) — no-op when debug is off"
  },
  "Dump and die": {
    "prefix": [
      "dd",
      "@dd"
    ],
    "body": [
      "@dd(${1:\\$var})"
    ],
    "description": "@dd($var) — no-op when debug is off"
  },
  "Layout": {
    "prefix": "layout",
    "body": [
      "@extends('layouts.${1:main}')",
      "",
      "@section('title', '${2:Page Title}')",
      "",
      "@push('head')",
      "    <meta name=\"description\" content=\"${3:}\">",
      "@endpush",
      "",
      "@style",
      "    /* ${4:page CSS} */",
      "@endstyle",
      "",
      "@section('content')",
      "    $0",
      "@endsection",
      "",
      "@script(defer)",
      "    // ${5:page JS}",
      "@endscript"
    ],
    "description": "Official LTE view structure"
  }
}
